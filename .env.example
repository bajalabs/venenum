# Copy to .env and fill in. Every setting has a default (README.md, Configuration); only the keys are needed to scan.

# Callers and their 32-byte keys as 64 hex characters, comma-separated: caller:key,caller2:key2
# Generate a key with: openssl rand -hex 32
VENENUM_HMAC_KEYS=

# Origins POST /v1/scan may fetch from, comma-separated (scheme://host[:port], no path). Empty: /v1/scan refuses every url.
VENENUM_FETCH_ORIGINS=

# VENENUM_MAX_BYTES=26214400
# VENENUM_MAX_SIGNATURE_AGE_HOURS=72
# VENENUM_SIGNING_WINDOW_SECONDS=60
# VENENUM_FETCH_TIMEOUT_MS=60000
# VENENUM_JSON_BODY_LIMIT=65536
# VENENUM_LOG_LEVEL=info

# Outside compose: where clamd listens (a Unix socket, or a host and port, not both)
# CLAMD_SOCKET=/tmp/clamd.sock
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=90000
# HOST=0.0.0.0
# PORT=3330

# compose.yaml only: where the published port is bound on the host
# VENENUM_BIND=127.0.0.1
# VENENUM_PORT=3330
